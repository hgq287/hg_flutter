# Public runtime config only. Do not put secrets here.
# Copy to .env.local for machine-specific overrides (gitignored).
# Prefer --dart-define=FLAVOR=dev --dart-define=API_HOST=... in CI.

FLAVOR=dev
API_HOST=http://localhost:4096
API_VERSION=v1
API_SIGNIN=signin
API_SIGNUP=signup
# Public OAuth client id only. Never put a client_secret in a mobile app.
OAUTH2_CLIENT_ID=
# true lets the sample app sign in without a backend (dev only).
DEMO_AUTH=true
